[Unit]
Description=AURORA-6 - Simulador de sensores de estructura (Miembro A)
After=network.target

[Service]
Type=simple
User=guillermo_a
ExecStart=/opt/aurora6/tools/structure-monitor.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
